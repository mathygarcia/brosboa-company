# BROSBOA COMPANY — static hosting (Hostinger / Apache)

# Force UTF-8
AddDefaultCharset UTF-8

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache strategy:
# - HTML: never cache (so new deploys show immediately)
# - CSS/JS/img: cache long, but filenames carry ?v=YYYYMMDD cache-busters
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|webp|jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Pretty + safe defaults
Options -Indexes
ErrorDocument 404 /404.html
